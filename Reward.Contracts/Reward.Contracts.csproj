<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version> <!-- x-release-please-version -->
    <PackageId>Reward.Contracts</PackageId>
    <Description>Public Protocol Buffers and generated gRPC types exposed by the Reward service.</Description>
    <PackageTags>grpc;protobuf;contracts</PackageTags>
    <PackageProjectUrl>https://github.com/ProjectLanternDI3P1P2/dotnet-backend-template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProjectLanternDI3P1P2/dotnet-backend-template.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\reward_inventory_v1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\reward_placeholder_v1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\reward_events_v1.proto" GrpcServices="None" />
    <!-- Consumers that use another language can retrieve the source contract from the package. -->
    <None Include="Protos/reward_inventory_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="Protos/reward_placeholder_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="Protos/reward_events_v1.proto" Pack="true" PackagePath="proto" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
